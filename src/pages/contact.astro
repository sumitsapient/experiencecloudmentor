---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact">
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
        Contact
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">Let's Talk Training</h1>
      <p class="mt-4 text-lg text-ink-500">
        Fill out the form and I'll get back to you within 24 hours, or reach me directly via email/WhatsApp.
      </p>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-10 space-y-6 rounded-2xl border border-ink-100 bg-white p-6 shadow-sm sm:p-8"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium text-ink-700">Full Name</label>
            <input
              type="text"
              name="name"
              id="name"
              required
              class="mt-2 block w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-700">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              required
              class="mt-2 block w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500"
            />
          </div>
        </div>

        <div>
          <label for="course" class="block text-sm font-medium text-ink-700">Course of Interest</label>
          <select
            name="course"
            id="course"
            class="mt-2 block w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500"
          >
            <option>AEM Developer &amp; Architect Training</option>
            <option>Real-Time CDP (RTCDP)</option>
            <option>Adobe Journey Optimizer (AJO)</option>
            <option>Adobe Target</option>
            <option>Edge Delivery Services (EDS)</option>
            <option>Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-ink-700">Message</label>
          <textarea
            name="message"
            id="message"
            rows="5"
            required
            class="mt-2 block w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 sm:w-auto"
        >
          Send Message
        </button>
      </form>

      <div class="mt-10 flex flex-col gap-2 text-sm text-ink-500 sm:flex-row sm:gap-8">
        <a href="mailto:contact@experiencecloudmentor.com" class="inline-flex items-center gap-1.5 hover:text-brand-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          contact@experiencecloudmentor.com
        </a>
        <a href="https://wa.me/916361989883" class="inline-flex items-center gap-1.5 hover:text-brand-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.39a9.9 9.9 0 004.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.35-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.09 1-2.38.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.58.81 2 .88 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.52 1.9 1.05.94 1.93 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.53.72 1.79.85.26.13.43.19.5.3.07.11.07.62-.17 1.3z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
