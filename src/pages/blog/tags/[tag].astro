---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { slugifyTag } from '../../../utils/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagMap = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const tagSlug = slugifyTag(tag);
      if (!tagMap.has(tagSlug)) tagMap.set(tagSlug, { label: tag, posts: [] });
      tagMap.get(tagSlug)!.posts.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tagSlug, { label, posts: taggedPosts }]) => ({
    params: { tag: tagSlug },
    props: {
      label,
      posts: taggedPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { label, posts } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Articles tagged "${label}"`,
  url: new URL(`/blog/tags/${Astro.params.tag}/`, Astro.site).toString(),
};
---

<BaseLayout
  title={`#${label}`}
  description={`Articles tagged "${label}" — practical write-ups on AEM, EDS, RTCDP, AJO, and Adobe Target.`}
  schema={schema}
>
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <a href="/blog" class="text-sm font-semibold text-brand-600 hover:underline">← All articles</a>
      <span class="mt-6 inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
        Tag
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Articles tagged &ldquo;{label}&rdquo;
      </h1>
      <p class="mt-4 text-ink-500">{posts.length} article{posts.length === 1 ? '' : 's'}</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <BlogPostCard
            slug={post.data.slug}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            author={post.data.author}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
