---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { slugifyTag } from '../../utils/tags';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Blog"
  description="Practical write-ups on AEM, EDS, RTCDP, AJO, and Adobe Target — drawn from real project experience."
  keywords={['AEM blog', 'Adobe Experience Cloud blog', 'RTCDP articles', 'AJO articles', 'Adobe Target articles']}
>
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
        Blog
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Insights on AEM &amp; Adobe Experience Cloud
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-500">
        Practical write-ups on AEM, EDS, RTCDP, AJO, and Adobe Target — drawn from real project experience.
      </p>

      {allTags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <a
              href={`/blog/tags/${slugifyTag(tag)}`}
              class="rounded-full border border-ink-200 px-3 py-1 text-xs font-semibold text-ink-700 hover:border-brand-300 hover:text-brand-600"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      {posts.length === 0 ? (
        <div class="mt-10 rounded-2xl border border-dashed border-ink-200 p-10 text-center">
          <p class="text-ink-500">We're working on our first articles — check back soon.</p>
          <a href="/contact" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:underline">
            Have a topic you'd like us to cover? Get in touch →
          </a>
        </div>
      ) : (
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <BlogPostCard
              slug={post.data.slug}
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              author={post.data.author}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}
    </section>
  </main>
  <Footer />
</BaseLayout>
