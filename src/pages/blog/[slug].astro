---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../utils/posts';
import { slugifyTag } from '../../utils/tags';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => isPublished(post.data.publishDate));
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const relatedPosts = (await getCollection('blog'))
  .filter((candidate) => isPublished(candidate.data.publishDate) && candidate.data.slug !== data.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTags: candidate.data.tags.filter((tag) => data.tags.includes(tag)).length,
  }))
  .filter((candidate) => candidate.sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf())
  .slice(0, 3)
  .map((candidate) => candidate.post);

const keywords = [...data.tags, data.author, 'Adobe Experience Cloud', 'AEM training'];

const canonicalPostURL = new URL(`/blog/${data.slug}/`, Astro.site).toString();
const authorAnchors = {
  'Sumit Yadav': 'sumit-yadav',
  'Gaurav Agarwal': 'gaurav-agarwal',
};
const authorURL = new URL(`/about/#${authorAnchors[data.author]}`, Astro.site).toString();
const reviewerURL = data.reviewedBy
  ? new URL(`/about/#${authorAnchors[data.reviewedBy]}`, Astro.site).toString()
  : undefined;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: new URL(data.ogImage ?? '/og-default.png', Astro.site).toString(),
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.modifiedDate ?? data.publishDate).toISOString(),
    author: { '@type': 'Person', '@id': authorURL, name: data.author, url: authorURL },
    ...(data.reviewedBy && reviewerURL
      ? { reviewedBy: { '@type': 'Person', '@id': reviewerURL, name: data.reviewedBy, url: reviewerURL } }
      : {}),
    publisher: { '@type': 'EducationalOrganization', '@id': `${Astro.site}#organization`, name: 'ExperienceCloudMentor', logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).toString() } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalPostURL },
    keywords: keywords.join(', '),
    ...(data.sources.length > 0 ? { citation: data.sources.map((source) => source.url) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonicalPostURL },
    ],
  },
];

if (data.faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.ogImage}
  type="article"
  keywords={keywords}
  publishDate={data.publishDate}
  modifiedDate={data.modifiedDate}
  author={data.author}
  schema={schema}
>
  <Header />
  <main class="flex-1">
    <article class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <a href="/blog/" class="text-sm font-semibold text-brand-600 hover:underline">← All articles</a>
      <p class="mt-6 text-sm font-medium text-ink-500">
        Published {data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {data.modifiedDate && (
          <> · Updated {data.modifiedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</>
        )}
        {' · '}
        <a href={authorURL.replace(Astro.site!.toString(), '/')} class="hover:text-brand-600 hover:underline">{data.author}</a>
        {data.reviewedBy && reviewerURL && (
          <> · Reviewed by <a href={reviewerURL.replace(Astro.site!.toString(), '/')} class="hover:text-brand-600 hover:underline">{data.reviewedBy}</a></>
        )}
      </p>
      <h1 class="mt-3 font-serif text-4xl font-bold leading-tight tracking-tight text-ink-900 sm:text-5xl">{data.title}</h1>
      {data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a
              href={`/blog/tags/${slugifyTag(tag)}/`}
              class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-200"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
      <div class="prose prose-slate prose-lg mt-10 max-w-none font-serif leading-relaxed text-ink-800 prose-headings:font-serif prose-headings:font-bold prose-headings:text-ink-900 prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-900">
        <Content />
      </div>

      {data.faqs.length > 0 && (
        <section class="mt-12 border-t border-ink-100 pt-10" aria-labelledby="article-faq-heading">
          <h2 id="article-faq-heading" class="font-serif text-2xl font-bold text-ink-900">Frequently asked questions</h2>
          <div class="mt-5 space-y-3">
            {data.faqs.map((faq) => (
              <details class="group rounded-xl border border-ink-100 p-5">
                <summary class="cursor-pointer list-none font-semibold text-ink-900 marker:content-none">
                  <span class="flex items-center justify-between gap-4">
                    {faq.question}
                    <span aria-hidden="true" class="text-brand-600 group-open:rotate-45">+</span>
                  </span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-ink-700">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {data.sources.length > 0 && (
        <section class="mt-12 border-t border-ink-100 pt-10" aria-labelledby="article-sources-heading">
          <h2 id="article-sources-heading" class="font-serif text-2xl font-bold text-ink-900">Sources</h2>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-ink-700">
            {data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">
                  {source.title}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-12 border-t border-ink-100 pt-10" aria-labelledby="related-guides-heading">
          <h2 id="related-guides-heading" class="font-serif text-2xl font-bold text-ink-900">Related guides</h2>
          <ul class="mt-5 divide-y divide-ink-100 border-y border-ink-100">
            {relatedPosts.map((relatedPost) => (
              <li>
                <a href={`/blog/${relatedPost.data.slug}/`} class="group block py-4">
                  <span class="block font-semibold text-ink-900 group-hover:text-brand-600">{relatedPost.data.title}</span>
                  <span class="mt-1 block text-sm text-ink-500">{relatedPost.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-12 rounded-2xl border border-brand-200 bg-brand-50/50 p-6">
        <p class="font-semibold text-ink-900">Need this implemented in your org?</p>
        <p class="mt-1 text-sm text-ink-700">
          I'm available for freelance and consulting engagements on AEM, EDS, RTCDP, AJO, and Adobe Target.{' '}
          <a href="/services/" class="font-semibold text-brand-600 hover:underline">See how we can work together →</a>
        </p>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
