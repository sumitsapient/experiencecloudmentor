---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<BaseLayout title={data.title} description={data.description}>
  <Header />
  <main class="flex-1">
    <article class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <a href="/blog" class="text-sm font-semibold text-brand-600 hover:underline">← All articles</a>
      <p class="mt-6 text-sm font-medium text-ink-500">
        {data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {' · '}{data.author}
      </p>
      <h1 class="mt-3 font-serif text-4xl font-bold leading-tight tracking-tight text-ink-900 sm:text-5xl">{data.title}</h1>
      {data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">{tag}</span>
          ))}
        </div>
      )}
      <div class="prose prose-slate prose-lg mt-10 max-w-none font-serif leading-relaxed text-ink-800 prose-headings:font-serif prose-headings:font-bold prose-headings:text-ink-900 prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-900">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
