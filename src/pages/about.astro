---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const highlights = [
  { label: 'Years of AEM experience', value: '10+' },
  { label: 'Students trained', value: '20+' },
  { label: 'Certifications held', value: '5' },
];

const certificationVerifyUrl = 'https://certification.adobe.com/credential/verify/02fd0009-8270-11f1-9e60-42010a400fe7';
const certifications = [
  'Adobe Certified Expert – AEM Sites Developer',
  'Adobe Certified Expert – AEM Sites Architect',
  'Adobe Certified Expert – Real-Time CDP',
  'Adobe Certified Expert – Journey Optimizer',
  'Adobe Certified Expert – Adobe Target',
];
---

<BaseLayout title="About">
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">About Me</span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Hi, I'm Sumit — Certified AEM Developer &amp; Architect
      </h1>
      <a
        href="https://www.linkedin.com/in/sumit-yadav/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.850 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11.001-4.124 2.062 2.062 0 01-.001 4.124zM7.114 20.452H3.558V9h3.556v11.452z" />
        </svg>
        Connect on LinkedIn
      </a>
      <p class="mt-6 text-lg leading-relaxed text-ink-700">
        With over 10 years of experience as an AEM Architect, I've designed and delivered enterprise-grade Adobe
        Experience Cloud solutions across industries like banking, financial services, and manufacturing — sectors
        where scale, security, and reliability aren't optional.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        Mentoring has always been a natural part of that journey. Whether guiding junior developers on my own teams
        or helping professionals break into AEM and the broader Adobe stack, I enjoy turning complex, real-world
        architecture problems into practical, learnable skills.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        My training is built the same way I build production systems: hands-on, project-driven, and grounded in
        scenarios you'll actually face on the job — not just slides and theory.
      </p>

      <div class="mt-10 grid grid-cols-3 gap-4 rounded-2xl border border-ink-100 bg-ink-50/50 p-6 text-center">
        {highlights.map((h) => (
          <div>
            <p class="text-2xl font-extrabold text-brand-600">{h.value}</p>
            <p class="mt-1 text-xs font-medium text-ink-500">{h.label}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-xl font-bold text-ink-900">Certifications</h2>
        <a href={certificationVerifyUrl} target="_blank" rel="noopener noreferrer" class="flex-shrink-0">
          <img
            src="/badges/adobe-certified-master.png"
            alt="Adobe Certified Master badge"
            class="h-24 w-auto"
            width="96"
            height="96"
          />
        </a>
      </div>
      <ul class="mt-4 space-y-2">
        {certifications.map((cert) => (
          <li>
            <a
              href={certificationVerifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-ink-700 underline decoration-ink-300 underline-offset-4 hover:text-brand-600 hover:decoration-brand-400"
            >
              {cert}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 text-xl font-bold text-ink-900">My Teaching Approach</h2>
      <p class="mt-4 text-ink-700">
        I teach the way I work — hands-on and project-first. Every module pairs core concepts with real
        architecture scenarios pulled from banking, financial services, and manufacturing projects, so you learn
        to think like an architect, not just follow steps. Sessions include live coding, doubt-solving, and
        practical assignments, with support even after the training wraps up.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
