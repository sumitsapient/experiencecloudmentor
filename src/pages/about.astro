---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const highlights = [
  { label: 'Years of combined experience', value: '14+' },
  { label: 'Students trained', value: '20+' },
  { label: 'Certifications held', value: '8' },
];

const certificationVerifyUrl = 'https://certification.adobe.com/credential/verify/02fd0009-8270-11f1-9e60-42010a400fe7';

const trainers = [
  {
    anchor: 'sumit-yadav',
    name: 'Sumit Yadav',
    title: 'AEM Developer & Architect',
    photo: '/team/sumit-yadav.jpg',
    linkedin: 'https://www.linkedin.com/in/sumit-yadav/',
    badge: '/badges/adobe-certified-master.png',
    verifyUrl: certificationVerifyUrl,
    shortBio:
      "With over 10 years of experience as an AEM Architect, Sumit has designed and delivered enterprise-grade Adobe Experience Cloud solutions across banking, financial services, and manufacturing — sectors where scale, security, and reliability aren't optional. He teaches the AEM Developer & Architect and Edge Delivery Services (EDS) courses.",
    certifications: [
      'Adobe Certified Expert – AEM Sites Developer',
      'Adobe Certified Expert – AEM Sites Architect',
      'Adobe Certified Expert – Real-Time CDP',
      'Adobe Certified Expert – Journey Optimizer',
      'Adobe Certified Expert – Adobe Target',
    ],
  },
  {
    anchor: 'gaurav-agarwal',
    name: 'Gaurav Agarwal',
    title: 'Adobe Experience Cloud Specialist',
    photo: '/team/gaurav-agarwal.jpg',
    linkedin: 'https://www.linkedin.com/in/gaurav4080/',
    badge: null,
    verifyUrl: 'https://certification.adobe.com/credential/verify/fd3d52e6-90cd-11f1-bdd6-42010a400002',
    shortBio:
      "Gaurav is an Adobe Experience Cloud Specialist with 4+ years of hands-on experience across Real-Time CDP, Journey Optimizer, and Adobe Target. He's helped enterprise teams build unified customer profiles and launch personalization programs that actually move the needle, and brings that same practical, campaign-ready focus to teaching. He trains the RTCDP, AJO, and Adobe Target courses.",
    certifications: [
      'Adobe Certified Expert – Real-Time CDP',
      'Adobe Certified Expert – Journey Optimizer',
      'Adobe Certified Expert – Adobe Target',
    ],
  },
];
---

<BaseLayout title="About">
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">Our Team</span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Meet the trainers behind ExperienceCloudMentor
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        We're a small team of certified Adobe Experience Cloud practitioners who train the way we work — hands-on,
        project-driven, and grounded in real enterprise scenarios, not just slides and theory.
      </p>

      <div class="mt-10 grid grid-cols-3 gap-4 rounded-2xl border border-ink-100 bg-ink-50/50 p-6 text-center">
        {highlights.map((h) => (
          <div>
            <p class="text-2xl font-extrabold text-brand-600">{h.value}</p>
            <p class="mt-1 text-xs font-medium text-ink-500">{h.label}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 space-y-14">
        {trainers.map((trainer) => (
          <div id={trainer.anchor} class="scroll-mt-24 border-t border-ink-100 pt-10 first:border-t-0 first:pt-0">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
              {trainer.photo ? (
                <img
                  src={trainer.photo}
                  alt={trainer.name}
                  class="h-24 w-24 flex-shrink-0 rounded-full object-cover"
                  width="96"
                  height="96"
                />
              ) : (
                <span class="flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 text-2xl font-bold text-brand-700">
                  {trainer.name.split(' ').map((n) => n[0]).join('')}
                </span>
              )}
              <div>
                <h2 class="text-xl font-bold text-ink-900">{trainer.name}</h2>
                <p class="text-sm font-medium text-brand-600">{trainer.title}</p>
                <a
                  href={trainer.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.850 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11.001-4.124 2.062 2.062 0 01-.001 4.124zM7.114 20.452H3.558V9h3.556v11.452z" />
                  </svg>
                  Connect on LinkedIn
                </a>
                <p class="mt-4 text-ink-700">{trainer.shortBio}</p>
              </div>
            </div>

            <div class="mt-6 flex flex-col items-start gap-4 pl-0 sm:pl-[7.5rem]">
              <div class="flex items-center gap-4">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-500">Certifications</h3>
                {trainer.badge && (
                  <a href={trainer.verifyUrl} target="_blank" rel="noopener noreferrer" class="flex-shrink-0">
                    <img
                      src={trainer.badge}
                      alt="Adobe Certified Master badge"
                      class="h-12 w-auto"
                      width="48"
                      height="48"
                    />
                  </a>
                )}
              </div>
              <ul class="space-y-2">
                {trainer.certifications.map((cert) => (
                  <li>
                    {trainer.verifyUrl ? (
                      <a
                        href={trainer.verifyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-ink-700 underline decoration-ink-300 underline-offset-4 hover:text-brand-600 hover:decoration-brand-400"
                      >
                        {cert}
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    ) : (
                      <span class="text-ink-700">{cert}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <h2 class="mt-14 text-xl font-bold text-ink-900">Our Teaching Approach</h2>
      <p class="mt-4 text-ink-700">
        We teach the way we work — hands-on and project-first. Every module pairs core concepts with real
        scenarios pulled from enterprise projects, so you learn to think like a practitioner, not just follow
        steps. Sessions include live demos, doubt-solving, and practical assignments, with support even after the
        training wraps up.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
