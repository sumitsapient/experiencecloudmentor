---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const services = [
  {
    category: 'AEM',
    title: 'AEM Development & Architecture',
    description:
      'New site builds, component development, integrations, and full migrations from AEM 6.x to AEM as a Cloud Service.',
    bullets: [
      'New site builds and component development',
      'AEM 6.x → AEM as a Cloud Service migrations',
      'Solution architecture and code/performance reviews',
      'DAM, headless, and third-party API integrations',
    ],
    instructor: 'Sumit Yadav',
  },
  {
    category: 'EDS',
    title: 'Edge Delivery Services Implementation',
    description: 'Content-first, high-performance site builds on Edge Delivery Services, from scratch or migrated from AEM.',
    bullets: [
      'New EDS site builds',
      'Migrating existing sites to EDS',
      'Block and component development',
      'Performance and Core Web Vitals tuning',
    ],
    instructor: 'Sumit Yadav',
  },
  {
    category: 'RTCDP',
    title: 'Real-Time CDP Implementation',
    description: 'Identity resolution, schema design, and audience building so your customer data is actually usable.',
    bullets: [
      'XDM schema design and data ingestion',
      'Identity resolution and merge policy setup',
      'Audience building and segmentation',
      'Activation to downstream destinations',
    ],
    instructor: 'Gaurav Agarwal',
  },
  {
    category: 'AJO',
    title: 'Adobe Journey Optimizer Implementation',
    description: 'Journey design and orchestration across channels, built on top of your RTCDP profiles.',
    bullets: [
      'Journey design and orchestration',
      'Cross-channel messaging (email, push, in-app)',
      'Event-triggered and real-time journeys',
      'Journey performance reporting',
    ],
    instructor: 'Gaurav Agarwal',
  },
  {
    category: 'Adobe Target',
    title: 'Adobe Target Setup & Personalization Programs',
    description: 'Testing architecture, audience targeting, and a personalization program your team can run independently.',
    bullets: [
      'Activity and audience architecture',
      'A/B and multivariate test setup',
      'Personalization program design',
      'Reporting and lift measurement',
    ],
    instructor: 'Gaurav Agarwal',
  },
];

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const schema = [
  ...services.map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: s.title,
    name: s.title,
    description: s.description,
    provider: { '@type': 'EducationalOrganization', name: 'ExperienceCloudMentor', url: Astro.site?.toString() },
    areaServed: 'Worldwide',
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
    ],
  },
];
---

<BaseLayout
  title="Services"
  description="Freelance and consulting engagements in AEM, Edge Delivery Services, Real-Time CDP, Adobe Journey Optimizer, and Adobe Target — delivered by Adobe Certified practitioners."
  keywords={['AEM freelancer', 'Adobe Experience Cloud consultant', 'RTCDP consulting', 'AJO consulting', 'Adobe Target consulting', 'AEM migration services']}
  schema={schema}
>
  <Header />
  <main class="flex-1">
    <section class="bg-brand-50/60">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
        <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
          Services
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Hire Us for Your Next AEM or Adobe Experience Cloud Project
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-500">
          Beyond training, we take on freelance and consulting engagements — from a focused implementation to a
          full migration — across AEM, EDS, RTCDP, AJO, and Adobe Target. Remote, project-based or ongoing.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-block rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
        >
          Discuss Your Project
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ink-900">What We Can Help With</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <div class="flex flex-col rounded-2xl border border-ink-100 bg-white p-6 shadow-sm">
            <span class="w-fit rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
              {service.category}
            </span>
            <h3 class="mt-4 text-lg font-bold text-ink-900">{service.title}</h3>
            <p class="mt-2 text-sm text-ink-500">{service.description}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-ink-700">
              {service.bullets.map((bullet) => (
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {bullet}
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs font-medium text-ink-500">Led by {service.instructor}</p>
          </div>
        ))}
      </div>
    </section>

    {caseStudies.length > 0 && (
      <section class="bg-ink-50/50 py-16">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-ink-900">Recent Work</h2>
          <p class="mt-2 max-w-2xl text-ink-500">
            A few examples of engagements we've delivered. Client names are withheld, but the problems, approach,
            and outcomes are real.
          </p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {caseStudies.map((study) => (
              <div class="flex flex-col rounded-2xl border border-ink-100 bg-white p-6 shadow-sm">
                <span class="w-fit rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
                  {study.data.category}
                </span>
                <h3 class="mt-4 text-base font-bold text-ink-900">{study.data.title}</h3>
                <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-ink-500">{study.data.client}</p>
                <div class="mt-4 space-y-3 text-sm text-ink-700">
                  <p><strong class="text-ink-900">Problem:</strong> {study.data.problem}</p>
                  <p><strong class="text-ink-900">Approach:</strong> {study.data.approach}</p>
                  <p><strong class="text-ink-900">Outcome:</strong> {study.data.outcome}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ink-900">How Engagements Work</h2>
      <p class="mt-4 text-ink-700">
        Most projects start with a short discovery call to understand scope, timeline, and budget — then we agree
        on either a fixed project quote or an hourly/retainer arrangement, whichever fits better. We work remotely
        and are comfortable with both India-based and international time zones.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
      >
        Get in Touch
      </a>
    </section>
  </main>
  <Footer />
</BaseLayout>
