---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Courses">
  <Header />
  <main class="flex-1">
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
        Courses
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Adobe Experience Cloud Training Programs
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-500">
        Hands-on courses covering AEM development, AEM architecture, EDS, RTCDP, AJO, and Adobe Target — delivered live,
        1:1 or in small batches.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {courses.map((course) => (
          <CourseCard
            slug={course.data.slug}
            title={course.data.title}
            tagline={course.data.tagline}
            category={course.data.category}
            level={course.data.level}
            duration={course.data.duration}
            featured={course.data.featured}
          />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
