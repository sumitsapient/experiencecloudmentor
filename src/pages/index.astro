---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const coursesPerPage = 3;

const credentials = [
  'Adobe Certified Expert – AEM Sites Developer',
  'Adobe Certified Expert – AEM Sites Architect',
  'Adobe Certified Expert – Real-Time CDP',
  'Adobe Certified Expert – Journey Optimizer',
  'Adobe Certified Expert – Adobe Target',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ExperienceCloudMentor',
  url: Astro.site,
};
---

<BaseLayout
  title="Home"
  description="Freelance/consulting and hands-on training in AEM, Edge Delivery Services, Real-Time CDP, Journey Optimizer, and Adobe Target — delivered by Adobe Certified practitioners. Hire us for a project or learn 1:1."
  keywords={['AEM training', 'AEM freelancer', 'Adobe Experience Cloud training', 'Adobe Experience Cloud consultant', 'RTCDP training', 'AJO training', 'Adobe Target training', 'EDS training', 'Adobe certified trainer']}
  schema={schema}
>
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div>
            <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
              Certified AEM Developer &amp; Architect
            </span>
            <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
              AEM, EDS, RTCDP, AJO &amp; Adobe Target — Hire Us or Learn From Us
            </h1>
            <p class="mt-5 text-lg text-ink-500">
              Hands-on Adobe Experience Cloud expertise, available two ways: freelance and consulting engagements
              for teams who need it built, and project-driven training for developers and marketers who want real
              skills, not just slides.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="/services"
                class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
              >
                Hire Me for a Project
              </a>
              <a
                href="/courses"
                class="rounded-full border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-700 hover:bg-ink-50"
              >
                Learn With Me
              </a>
            </div>
          </div>
          <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-lg">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Why Train With Us</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-700">
                  Every session is built around real project scenarios — not just theory — so you're ready to
                  deliver from day one, whether you're switching roles or leveling up.
                </p>
              </div>
              <img
                src="/badges/adobe-certified-master.png"
                alt="Adobe Certified Master badge"
                class="h-16 w-auto flex-shrink-0"
                width="64"
                height="64"
              />
            </div>
            <ul class="mt-5 space-y-3 border-t border-ink-100 pt-5">
              {credentials.map((cred) => (
                <li class="flex items-start gap-2 text-sm text-ink-700">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {cred}
                </li>
              ))}
            </ul>
            <p class="mt-5 border-t border-ink-100 pt-4 text-xs font-medium text-brand-700">
               Ideal for professionals targeting a new role in Adobe Experience Cloud
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Courses -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-bold text-ink-900 sm:text-3xl">Our Courses</h2>
          <p class="mt-2 text-ink-500">Browse the most in-demand training tracks.</p>
        </div>
        <a href="/courses" class="hidden text-sm font-semibold text-brand-600 hover:underline sm:block">
          View all courses →
        </a>
      </div>
      <div id="courses-pagination" data-page-size={coursesPerPage}>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {courses.map((course, i) => (
            <div class="course-page-item" data-page={Math.floor(i / coursesPerPage)}>
              <CourseCard
                slug={course.data.slug}
                title={course.data.title}
                tagline={course.data.tagline}
                category={course.data.category}
                level={course.data.level}
                duration={course.data.duration}
                featured={course.data.featured}
                instructor={course.data.instructor}
              />
            </div>
          ))}
        </div>

        {courses.length > coursesPerPage && (
          <div class="mt-8 flex items-center justify-center gap-4">
            <button
              id="courses-prev"
              type="button"
              aria-label="Previous courses"
              class="rounded-full border border-ink-200 p-2 text-ink-700 hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div id="courses-dots" class="flex items-center gap-2"></div>
            <button
              id="courses-next"
              type="button"
              aria-label="Next courses"
              class="rounded-full border border-ink-200 p-2 text-ink-700 hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const container = document.getElementById('courses-pagination');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.course-page-item'));
  const prevBtn = document.getElementById('courses-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('courses-next') as HTMLButtonElement | null;
  const dotsContainer = document.getElementById('courses-dots');

  if (container && items.length > 0) {
    const pageSize = Number(container.dataset.pageSize ?? '3');
    const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
    let currentPage = 0;

    const dots: HTMLButtonElement[] = [];
    for (let i = 0; i < totalPages; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Go to page ${i + 1}`);
      dot.className = 'h-2 w-2 rounded-full bg-ink-200 transition-colors';
      dot.addEventListener('click', () => goToPage(i));
      dotsContainer?.appendChild(dot);
      dots.push(dot);
    }

    function render() {
      items.forEach((item) => {
        const page = Number(item.dataset.page ?? '0');
        item.classList.toggle('hidden', page !== currentPage);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-brand-600', i === currentPage);
        dot.classList.toggle('bg-ink-200', i !== currentPage);
      });
      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages - 1;
    }

    function goToPage(page: number) {
      currentPage = Math.min(Math.max(page, 0), totalPages - 1);
      render();
    }

    prevBtn?.addEventListener('click', () => goToPage(currentPage - 1));
    nextBtn?.addEventListener('click', () => goToPage(currentPage + 1));
    render();
  }
</script>
