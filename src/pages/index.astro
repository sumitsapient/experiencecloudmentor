---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const featuredCourses = courses.filter((c) => c.data.featured);

const credentials = [
  'Adobe Certified Expert – AEM Sites Developer',
  'Adobe Certified Expert – AEM Sites Architect',
  'Adobe Certified Expert – Real-Time CDP',
  'Adobe Certified Expert – Journey Optimizer',
  'Adobe Certified Expert – Adobe Target',
];
---

<BaseLayout title="Home">
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div>
            <span class="inline-block rounded-full bg-brand-100 px-4 py-1 text-xs font-semibold text-brand-700">
              Certified AEM Developer &amp; Architect
            </span>
            <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
              Learn AEM, EDS, RTCDP, AJO &amp; Adobe Target from a Certified Practitioner
            </h1>
            <p class="mt-5 text-lg text-ink-500">
              Hands-on, project-driven training designed for developers and marketers who want real skills — not
              just slides. 1:1 mentoring and small batch cohorts available.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="/courses"
                class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
              >
                Explore Courses
              </a>
              <a
                href="/contact"
                class="rounded-full border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-700 hover:bg-ink-50"
              >
                Get in Touch
              </a>
            </div>
          </div>
          <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-lg">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Why Train With Us</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-700">
                  Every session is built around real project scenarios — not just theory — so you're ready to
                  deliver from day one, whether you're switching roles or leveling up.
                </p>
              </div>
              <img
                src="/badges/adobe-certified-master.png"
                alt="Adobe Certified Master badge"
                class="h-16 w-auto flex-shrink-0"
                width="64"
                height="64"
              />
            </div>
            <ul class="mt-5 space-y-3 border-t border-ink-100 pt-5">
              {credentials.map((cred) => (
                <li class="flex items-start gap-2 text-sm text-ink-700">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {cred}
                </li>
              ))}
            </ul>
            <p class="mt-5 border-t border-ink-100 pt-4 text-xs font-medium text-brand-700">
              🎯 Ideal for professionals targeting a new role in Adobe Experience Cloud
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Courses -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-bold text-ink-900 sm:text-3xl">Popular Courses</h2>
          <p class="mt-2 text-ink-500">Start with the most in-demand training tracks.</p>
        </div>
        <a href="/courses" class="hidden text-sm font-semibold text-brand-600 hover:underline sm:block">
          View all courses →
        </a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredCourses.map((course) => (
          <CourseCard
            slug={course.data.slug}
            title={course.data.title}
            tagline={course.data.tagline}
            category={course.data.category}
            level={course.data.level}
            duration={course.data.duration}
            featured={course.data.featured}
          />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
