---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Certified AEM Developer & Architect offering hands-on training in AEM, RTCDP, AJO, and Adobe Target.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Adobe Experience Cloud Training</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white antialiased">
    <slot />
  </body>
</html>
