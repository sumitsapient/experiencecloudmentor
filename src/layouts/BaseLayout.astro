---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image URL used for social sharing previews. */
  image?: string;
  /** 'website' for standard pages, 'article' for blog posts. */
  type?: 'website' | 'article';
  keywords?: string[];
  /** Set true to keep a page out of search results (e.g. thank-you pages). */
  noindex?: boolean;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  /** One or more JSON-LD objects to inject in addition to the sitewide Organization schema. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Certified AEM Developer & Architect offering hands-on training in AEM, RTCDP, AJO, and Adobe Target.',
  image,
  type = 'website',
  keywords = [],
  noindex = false,
  publishDate,
  modifiedDate,
  author,
  schema,
} = Astro.props;

const siteName = 'ExperienceCloudMentor';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? '/og-default.png', Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${Astro.site}#organization`,
  name: siteName,
  url: Astro.site,
  logo: new URL('/logo.png', Astro.site).toString(),
  description:
    'Hands-on Adobe Experience Cloud training in AEM, Edge Delivery Services, Real-Time CDP, Adobe Journey Optimizer, and Adobe Target.',
  email: 'contact@experiencecloudmentor.com',
  sameAs: ['https://www.linkedin.com/in/sumit-yadav/', 'https://www.linkedin.com/in/gaurav4080/'],
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [organizationSchema, ...extraSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} Blog`} href="/rss.xml" />

    <title>{title} | Adobe Experience Cloud Training</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#234bda" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate.toISOString()} />
    )}
    {type === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {allSchemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-white antialiased">
    <slot />
  </body>
</html>
