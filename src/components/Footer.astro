---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-ink-100 bg-ink-900 text-ink-100">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-white">Experience<span class="text-brand-400">CloudMentor</span></p>
        <p class="mt-2 text-sm text-ink-300">
          Certified AEM Developer &amp; Architect. Practical, hands-on training in AEM, Real-Time CDP, Adobe Journey
          Optimizer, and Adobe Target.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-ink-300">Explore</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/courses" class="hover:text-white">All Courses</a></li>
          <li><a href="/about" class="hover:text-white">About Me</a></li>
          <li><a href="/faq" class="hover:text-white">FAQ</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-ink-300">Get in touch</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/contact" class="hover:text-white">Contact form</a></li>
          <li><a href="mailto:contact@experiencecloudmentor.com" class="hover:text-white">contact@experiencecloudmentor.com</a></li>
          <li><a href="https://wa.me/910000000000" class="hover:text-white">WhatsApp</a></li>
          <li><a href="https://www.linkedin.com/in/sumit-yadav/" target="_blank" rel="noopener noreferrer" class="hover:text-white">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-ink-800 pt-6 text-xs text-ink-400">
      © {year} ExperienceCloudMentor. All rights reserved.
    </div>
  </div>
</footer>
