---
import { slugifyTag } from '../utils/tags';

interface Props {
  slug: string;
  title: string;
  description: string;
  publishDate: Date;
  author: string;
  tags?: string[];
}

const { slug, title, description, publishDate, author, tags = [] } = Astro.props;
---

<div class="group flex flex-col rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
  <a href={`/blog/${slug}`} class="flex flex-1 flex-col">
    <p class="text-xs font-medium text-ink-500">
      {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {' · '}{author}
    </p>
    <h2 class="mt-2 text-lg font-bold text-ink-900 group-hover:text-brand-600">{title}</h2>
    <p class="mt-2 text-sm text-ink-500">{description}</p>
    <span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600">
      Read more
      <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </a>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 border-t border-ink-100 pt-4">
      {tags.map((tag) => (
        <a
          href={`/blog/tags/${slugifyTag(tag)}`}
          class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-600 hover:bg-brand-100"
        >
          {tag}
        </a>
      ))}
    </div>
  )}
</div>
